GEMINI_API_KEY=
# Image backend used by the MCP image server: "placeholder" (offline, Pillow) or "openai"
IMAGE_BACKEND=placeholder
# Only needed for IMAGE_BACKEND=openai
OPENAI_API_KEY=
# Optional: image model and quality (lower quality = cheaper)
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
# Optional: text/vision model (default gemini-2.5-flash)
CAROUSEL_MODEL=gemini-2.5-flash
