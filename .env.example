# Copy this file to ".env" (same folder) and fill in your key. Never commit .env.

# One OpenAI key is used for text, image review AND image generation.
OPENAI_API_KEY=

# Text + image-review model (must accept images and structured output)
CAROUSEL_MODEL=gpt-6-luna
# Optional: lower reasoning effort = cheaper/faster (e.g. low). Leave empty for the default.
CAROUSEL_REASONING=

# Image backend: "openai" = real images, "placeholder" = free plain gradients for testing
IMAGE_BACKEND=openai
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# low | medium | high (lower = cheaper)
OPENAI_IMAGE_QUALITY=low
