# Copy this file to ".env" (same folder) and fill in your keys. Never commit .env.

# Text + image-review model (Google AI Studio key)
GEMINI_API_KEY=
# Optional: Gemini model name (default gemini-2.5-flash)
CAROUSEL_MODEL=gemini-2.5-flash

# Image backend: "openai" = real images, "placeholder" = free plain gradients for testing
IMAGE_BACKEND=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high (lower = cheaper)
OPENAI_IMAGE_QUALITY=low
